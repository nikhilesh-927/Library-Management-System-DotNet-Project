@model IEnumerable<LibraryMember>

@{
    ViewData["Title"] = "Issued Books List";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-journal-bookmark-fill me-2"></i>College Library - Issued Books
            </h2>
            <p class="text-muted mb-0">Manage and track all issued books, return dates, and overdue fines.</p>
        </div>
        <div>
            <a asp-controller="Library" asp-action="IssueBook" class="btn btn-primary shadow-sm px-3">
                <i class="bi bi-plus-circle me-1"></i> Issue New Book
            </a>
            <a asp-controller="Library" asp-action="About" class="btn btn-outline-secondary shadow-sm ms-2">
                <i class="bi bi-info-circle me-1"></i> About Library
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Member Name</th>
                            <th>Department</th>
                            <th>Book Title</th>
                            <th>Issue Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                            <th>Fine (₹)</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No issued books found. Click "Issue New Book" to add one.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                string status = item.GetDueStatus();
                                decimal fine = item.CalculateFine();
                                string badgeClass = status switch
                                {
                                    "Returned" => "bg-success",
                                    "Due Soon" => "bg-warning text-dark",
                                    "Overdue" => "bg-danger",
                                    _ => "bg-info text-dark"
                                };

                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.MemberName</div>
                                        <small class="text-muted">@item.Email</small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@item.Department</span></td>
                                    <td class="fw-bold text-dark">@(item.Book?.Title ?? $"Book #{item.BookId}")</td>
                                    <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @(item.ReturnDate.HasValue ? item.ReturnDate.Value.ToString("dd MMM yyyy") : "N/A")
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass fs-6 px-3 py-2 rounded-pill">
                                            @status
                                        </span>
                                    </td>
                                    <td>
                                        @if (fine > 0)
                                        {
                                            <span class="fw-bold text-danger">₹@fine</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">₹0</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="Library" asp-action="BookDetails" asp-route-id="@item.MemberId" 
                                           class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-eye me-1"></i> Book Details
                                        </a>
                                        @if (!item.IsReturned)
                                        {
                                            <form asp-controller="Library" asp-action="ReturnBook" asp-route-id="@item.MemberId" 
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success" 
                                                        onclick="return confirm('Mark this book as returned?');">
                                                    <i class="bi bi-check2-square"></i> Return
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
